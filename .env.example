# Public Firebase web configuration (safe to expose to the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=replace-me
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=replace-me

# Server-side Firebase Admin configuration
FIREBASE_PROJECT_ID=your-project-id
# Use Application Default Credentials in managed hosting. For local development,
# set FIREBASE_SERVICE_ACCOUNT_KEY to a one-line service-account JSON object.
FIREBASE_SERVICE_ACCOUNT_KEY=

# At least 32 random bytes. Rotating this invalidates voter cookies.
VOTER_COOKIE_SECRET=replace-with-a-long-random-secret

# Server-only contact-form delivery through Resend (https://resend.com)
RESEND_API_KEY=re_replace-me
CONTACT_FROM_EMAIL=Frk Polls <contact@your-verified-domain.example>
CONTACT_TO_EMAIL=your-private-inbox@example.com
